# ==============================================================================
# ChatUK Mobile Application Environment Variables Template
# Copy this file to `.env` in the project root and fill in your values.
# ==============================================================================

# Backend API URL (for Expo Web / iOS Simulator use localhost; for Android Emulator use 10.0.2.2; for Physical Device use your LAN IP e.g. 192.168.1.X)
EXPO_PUBLIC_BACKEND_URL=http://localhost:5000

# Alternative host/port overrides for custom dev environments
EXPO_PUBLIC_BACKEND_HOST=
EXPO_PUBLIC_BACKEND_PORT=5000

