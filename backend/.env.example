# ==============================================================================
# ChatUK Backend Environment Variables Template
# Copy this file to `backend/.env` and fill in your values.
# ==============================================================================

# Server Configuration
PORT=5000
NODE_ENV=development

# MongoDB Connection String (Atlas Replica Set or Local MongoDB)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/chatuk?retryWrites=true&w=majority

# In-Memory Session Caching (Redis)
# Set to 'false' to bypass Redis and use MongoDB fallback
ENABLE_REDIS=true
REDIS_URL=redis://127.0.0.1:6379

# Better Auth Security Configuration
# Generate a secure 32+ character string (e.g. `openssl rand -base64 32`)
BETTER_AUTH_SECRET=your_random_32_character_secret_key_here
BETTER_AUTH_URL=http://localhost:5000
TRUSTED_ORIGINS=http://localhost:5000,http://localhost:8081,chatuk://,exp://

# Social Authentication (Optional)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Cloudinary Media Storage
# Storage convention: All assets are stored under `chatuk/` root folder
CLOUDINARY_URL=cloudinary://<api_key>:<api_secret>@<cloud_name>

# Email Delivery for Contact & Feedback Submissions (Nodemailer / MailDog)
MAIL_DOG_HOST=mail.maildog.io
MAIL_DOG_PORT=2525
MAIL_DOG_USERNAME=
MAIL_DOG_PASSWORD=

# Mailtrap SMTP Configuration for Password Reset & Transactional Emails
# (Lowercase aliases supported: mailtraphost, mailtrapport, mailtrapusername, mailtrappassword)
MAILTRAP_HOST=sandbox.smtp.mailtrap.io
MAILTRAP_PORT=2525
MAILTRAP_USERNAME=
MAILTRAP_PASSWORD=

